<?xml version="1.0" encoding="UTF-8"?>
<ccs-ui ns="ccs_dl_server">
    <types>
        <struct>
           <ns>server</ns>
           <name>config</name>
           <desc>Configure values specific to the http server</desc>
           <member>
               <name>version</name>
               <type>int</type>
               <desc>configuration defined version</desc>
           </member>
           <member>
               <name>secret</name>
               <type>string</type>
               <desc>secret used for encryption</desc>
           </member>
           <member>
               <name>password</name>
               <type>string</type>
               <desc>unencrypted password- will be converted to a hash</desc>
           </member>
	   <member>
               <name>metric</name>
               <type>boolean</type>
	       <desc>If true, use metric units for display, otherwise, use Imperial</desc>
           </member>
        </struct>
    </types>
    <ui>
        <object>
            <name>paths</name>
	    <type>top:paths</type>
            <defaults>
                <base>/opt/ccs/DataServer</base>
                <log>/opt/ccs/DataServer/log</log>
	        <csv>/opt/ccs/DataLogger/csv</csv>
	        <photos>/opt/ccs/DataLogger/photos</photos>
	        <videos>/opt/ccs/DataLogger/videos</videos>
            </defaults>
        </object>
        <object>
            <name>internal</name>
	    <type>server:config</type>
            <defaults>
		    <version>1</version>
                    <secret>cafebeef</secret>
                    <password>MeasureYourWorld</password>
                    <metric>true</metric>
            </defaults>
        </object>
    </ui>
</ccs-ui>

